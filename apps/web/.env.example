# Copy to .env; ignored by Git. Server-side secrets for loaders, actions, and
# /api/* resource routes. Loaded by Node (`--env-file-if-exists=.env`) before
# the server starts, so read them with `process.env.NAME` inside the handler.
#
# Never give a secret a VITE_ prefix — those are inlined into the browser bundle.
# See ../.env.example for the backend (Python/ADK) Vercel project's variables.

# Must match the AI_MODE deployed on the backend project; only used here to
# label the UI, the backend enforces the real behaviour.
AI_MODE=demo

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# The backend project's deployment URL, e.g. https://dear-men-api.vercel.app.
# Locally this is the loopback uvicorn process from the backend README section.
BACKEND_API_URL=http://127.0.0.1:8000
# Must match BACKEND_SHARED_SECRET on the backend project.
BACKEND_SHARED_SECRET=YOUR_RANDOM_SHARED_SECRET
