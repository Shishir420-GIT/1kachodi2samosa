# Copy to .env; ignored by Git. English is the initial product language.
# These are the backend (Python/ADK) Vercel project's environment variables.
# See apps/web/.env.example for the frontend project's variables.

AI_MODE=demo
# For a free-tier project, use a server-only Gemini API key.
GEMINI_MODEL=gemini-3.8-flash
DAILY_MODEL_CALL_LIMIT=100
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY
# Vertex is an optional paid route. Remove GOOGLE_API_KEY and set the flag to
# true only if paid Vertex usage is intended.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Required by story storage and daily reminder delivery. Never expose this
# value to the frontend project or any browser-side variable.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Shared with the frontend project's BACKEND_SHARED_SECRET. Proves a request
# to /respond, /stories or /reminders/unsubscribe came from this app's own
# frontend server, not a direct public caller bypassing its rate limits.
# Generate with: openssl rand -hex 32
BACKEND_SHARED_SECRET=YOUR_RANDOM_SHARED_SECRET

# Authorizes POST /cron/reminders. Vercel sends `Authorization: Bearer
# $CRON_SECRET` automatically for the cron job declared in vercel.json. Vercel
# Cron on the Hobby plan only fires once a day; to send reminders at each
# user's preferred local time, also call this endpoint every ~15 minutes from
# a free external scheduler (e.g. cron-job.org) using the same bearer token.
# Generate with: openssl rand -hex 32
CRON_SECRET=YOUR_RANDOM_CRON_SECRET

# Optional daily reminder email configuration. Resend is the proposed provider.
RESEND_API_KEY=YOUR_RESEND_API_KEY
REMINDER_FROM_EMAIL=practice@reminders.YOUR_VERIFIED_DOMAIN
PUBLIC_SITE_URL=https://YOUR_FRONTEND_VERCEL_URL
# Used to sign one-click unsubscribe links. Generate at least 32 random bytes.
UNSUBSCRIBE_SIGNING_SECRET=YOUR_RANDOM_SIGNING_SECRET
