# Copy to .env; ignored by Git. English is the initial product language.
AI_MODE=demo
GOOGLE_CLOUD_PROJECT=YOUR_GCLOUD_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
CLOUD_RUN_REGION=asia-south1
CLOUD_RUN_SERVICE=dear-men
# For a billing-disabled free-tier project, use a server-only Gemini API key.
GEMINI_MODEL=gemini-flash-latest
DAILY_MODEL_CALL_LIMIT=100
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=SET_IN_SECRET_MANAGER
# Vertex is an optional paid route. Remove GOOGLE_API_KEY and set the flag to
# true only if paid Vertex usage is intended.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Required only by trusted backend jobs such as daily reminder delivery.
# Never expose this value through /api/config or browser-side variables.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Optional daily reminder email configuration. Resend is the proposed provider.
RESEND_API_KEY=YOUR_RESEND_API_KEY
REMINDER_FROM_EMAIL=practice@reminders.YOUR_VERIFIED_DOMAIN
PUBLIC_SITE_URL=https://YOUR_CLOUD_RUN_URL
# Used to sign one-click unsubscribe links. Generate at least 32 random bytes.
UNSUBSCRIBE_SIGNING_SECRET=YOUR_RANDOM_SIGNING_SECRET
PORT=8080
